# ==========================================
# Ollama Configuration (Local, Free, Offline)
# ==========================================
# Point to your local Ollama instance (default: http://localhost:11434/v1)
OLLAMA_BASE_URL="http://localhost:11434/v1"

# Specify the model name available in your Ollama installation
# (e.g. llama3.1:8b, gemma4:latest, mistral, qwen2.5:7b)
MODEL="ollama:llama3.1:8b"

# ==========================================
# Alternative Cloud Providers (Optional)
# ==========================================
# OPENAI_API_KEY="sk-..."
# GEMINI_API_KEY="..."
# ANTHROPIC_API_KEY="sk-ant-..."
